              {
                "textRuns": [
                  {
                    "value": "How to read 'vs typical':",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " each holiday is compared with an ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238"
                    }
                  },
                  {
                    "value": "average 2024 day of the same weekday",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", excluding holidays. Christmas (a Wednesday): ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238"
                    }
                  },
                  {
                    "value": "53,799",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " trips vs ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238"
                    }
                  },
                  {
                    "value": "119,223",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " on a typical Wednesday = ",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238"
                    }
                  },
                  {
                    "value": "-55%",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ". Whole-year baseline, so seasonal swings are included.",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#263238"
                    }
                  }
                ]
              }
